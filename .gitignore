# Dependencies
node_modules

# Build outputs
dist
dist-ssr

# Local env files
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Android build artifacts
app-debug.apk
app-release.apk
*.apk
*.aab

# Android Gradle cache (local build state, not needed in repo)
android/.gradle/
android/app/build/
android/build/
android/capacitor-cordova-android-plugins/

# Android Studio workspace/caches (machine-specific)
android/.idea/workspace.xml
android/.idea/caches/
android/.idea/gradle.xml
android/.idea/navEditor.xml

# Capacitor generated assets (rebuilt by `npx cap sync`)
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json
android/app/src/main/res/xml/config.xml

# Scripts compiled output
scripts/*.class

# Misc local files
*.log

# 音频。曾经整类 ignore（注释写的是「served externally」）——
# 后果是：部署的网页版有声音（文件在服务器上躺着），而**任何一次干净 clone
# 构建出来的包都是哑的**，安卓 APK 从来没带过音效。2026-08-03 用户上报
# 「音效似乎没有装载」查到的就是这一条。
# 现在只忽略散落在别处的音频，public/ 下的 25 个 UI 反馈音必须进仓库（共 396 KB）。
*.mp3
*.wav
!public/*.mp3
!public/*.wav

# Claude Code local files
.claude/

# 塔罗原稿（118 MB PNG）：只提交 public/tarot 下压缩后的 webp，原稿留在本地
/tarot/
